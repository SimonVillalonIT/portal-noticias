---
import Layout from "../../layouts/Layout.astro";
import { sanity } from "../../lib/sanity-client";
import { renderPortableText } from "../../lib/portable-text.ts";
import Main from "../../components/NewsPage/main.astro";

export const prerender = false;

const { slug } = Astro.params;

const post = await sanity.fetch(
  `*[_type == "news" && slug.current == $slug][0]{
    title,
    content,
    source,
    imageUrl,
    image {
      asset->{
        url
      }
    }
  }`,
  { slug }
);

if (!post) {
  throw new Error(`Post no encontrado: ${slug}`);
}

const htmlContent = renderPortableText(post.content);
const imageSrc = post.imageUrl || post.image?.asset?.url;
---

<Layout title={post.title}>
  <Main title={post.title} imageSrc={imageSrc} source={post.source} htmlContent={htmlContent} /> 
</Layout>
