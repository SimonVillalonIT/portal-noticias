---
import Layout from "../../layouts/Layout.astro";
import { sanity } from "../../lib/sanity-client";

// Desactivar el prerenderizado para hacer la carga dinámica
export const prerender = false;

const { slug } = Astro.params; // Obtén el slug de la URL

// Obtención del post por slug (usando slug.current)
const post = await sanity.fetch(
  `*[_type == "news" && slug.current == $slug][0]{
      title,
      summary,
      content,
      imageUrl,
      source
  }`,
  { slug },
);

// Verifica si el post existe
if (!post) {
  throw new Error(`Post no encontrado: ${slug}`);
}
---

<Layout title={post.title}>
  <h1 class="my-6 px-6 text-center font-semibold text-4xl text-base-content">
    {post.title}
  </h1>

  <!-- Mostrar la imagen si existe -->
  {post.imageUrl && <img src={post.imageUrl} alt={post.title} />}

  <p>{post.source}</p>

  <article>
    <!-- Renderizar el contenido del post -->
    {
      post.content.map((block: any) => (
        <p>{block.children.map((child: any) => child.text).join(" ")}</p>
      ))
    }
  </article>
</Layout>
