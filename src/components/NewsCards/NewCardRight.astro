---
interface Props {
  newItem: NewType;
}
const { newItem } = Astro.props as Props;
---

<div class="card card-side bg-base-100 shadow-sm w-full">
  <div class="card-body w-full">
    <h2 class="card-title">{newItem.title}</h2>
    <p>{newItem.summary}</p>
    <div class="card-actions justify-start">
      <div class="badge badge-accent text-accent-content font-medium uppercase">
        {newItem.category}
      </div>
    </div>
  </div>
  <figure>
    <img
      class="size-5/6 rounded-lg"
      src={newItem.imageUrl || newItem.image?.asset?.url}
      alt=""
    />
  </figure>
</div>
