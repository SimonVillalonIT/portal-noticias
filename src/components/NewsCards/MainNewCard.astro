---
import NewsLink from "./NewsLink.astro";

interface Props {
  newItem: NewType;
}
const { newItem } = Astro.props as Props;
---

<NewsLink slug={newItem.slug.current}>
  <article class="card bg-base-100 w-96 shadow-sm">
    <figure>
      <img src={newItem.imageUrl || newItem.image?.asset?.url} alt="Shoes" />
    </figure>
    <div class="card-body">
      <h2 class="card-title text-2xl">
        {newItem.title}
      </h2>
      <p class="text-lg">{newItem.summary}</p>
      <div class="card-actions justify-end">
        <div
          class="badge badge-accent text-accent-content font-medium uppercase"
        >
          {newItem.category}
        </div>
      </div>
    </div>
  </article>
</NewsLink>
