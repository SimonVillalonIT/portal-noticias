---
interface Props {
    newItem: NewType
}
const {newItem} = Astro.props as Props;
---

<article class="card bg-base-100 w-96 shadow-sm">
  <figure>
    <img
      src={newItem.imageUrl || newItem.image?.asset?.url}
      alt="Shoes" />
  </figure>
  <div class="card-body">
    <h2 class="card-title">
        {newItem.title}
    </h2>
    <p>{newItem.summary}</p>
    <div class="card-actions justify-end">
      <div class="badge badge-outline">{newItem.category}</div>
    </div>
  </div>
</div>